# Copy to .env and fill in. Every value here has a working default in config.py;
# the system runs with no .env at all (MockLLMClient mode).

# Google AI Studio key (https://aistudio.google.com). NOT a Vertex AI credential.
# Leave empty to run the whole system against MockLLMClient with no network calls.
GEMINI_API_KEY=

# Model tiers. Reasoning tier does analysis and review; cheap tier does routing.
# Both default to 3.1 Flash Lite because it is the only free-tier model whose
# daily quota is large enough to run an eval -- see docs/adr/0006. To run the
# two-tier configuration of ADR 0004, set MODEL_REASONING to gemini-2.5-flash
# and expect 20 requests per day.
MODEL_REASONING=gemini-3.1-flash-lite
MODEL_CHEAP=gemini-3.1-flash-lite

# Rate limits. READ THESE OFF YOUR OWN AI STUDIO RATE-LIMIT PAGE -- free-tier
# quotas are per Google Cloud project, not per key, and have changed repeatedly.
# Measured on this project 2026-08-18:
#   gemini-3.1-flash-lite   15 RPM   250K TPM   500 RPD
#   gemini-2.5-flash         5 RPM   250K TPM    20 RPD
#   gemini-2.5-flash-lite   10 RPM   250K TPM    20 RPD
# The values below sit under those measurements on purpose.
RPM_FLASH=4
RPM_FLASH_LITE=12
RPD_BUDGET=450

# Escalation policy. See docs/adr/0003-escalation-policy.md.
AUTO_DECIDE_MAX_USD=25000
CONFIDENCE_THRESHOLD=0.75
