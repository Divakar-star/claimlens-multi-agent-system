# Copy to .env and fill in. Every value here has a working default in config.py;
# the system runs with no .env at all (MockLLMClient mode).

# Google AI Studio key (https://aistudio.google.com). NOT a Vertex AI credential.
# Leave empty to run the whole system against MockLLMClient with no network calls.
GEMINI_API_KEY=

# Model tiers. Reasoning tier does analysis and review; cheap tier does routing.
MODEL_REASONING=gemini-2.5-flash
MODEL_CHEAP=gemini-2.5-flash-lite

# Rate limits. READ THESE OFF YOUR OWN AI STUDIO RATE-LIMIT PAGE -- free-tier
# quotas are per Google Cloud project and have changed repeatedly. The defaults
# below are deliberately conservative, not the published maximums.
RPM_FLASH=10
RPM_FLASH_LITE=15
RPD_BUDGET=200

# Escalation policy. See docs/adr/0003-escalation-policy.md.
AUTO_DECIDE_MAX_USD=25000
CONFIDENCE_THRESHOLD=0.75
